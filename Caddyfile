# Serve the PWA on http://localhost:8080.
# (Cloud-hosted PWA on Cloudflare Pages is what your phone will install;
#  this local server is for laptop browsing.)
:80 {
    root * /srv
    file_server
    try_files {path} {path}/ /index.html

    # Cache static assets, but never pin the service worker itself. If sw.js
    # is cached for a day, an installed PWA can keep running old interaction
    # code after a deploy.
    @assets path *.png *.svg *.ico *.json
    header @assets Cache-Control "public, max-age=86400"

    @fresh path /index.html / /sw.js
    header @fresh Cache-Control "no-cache, no-store, must-revalidate"

    log {
        output stdout
        format console
    }
}
