# Copy to `.env` and fill in. The `cron` service in docker-compose.yml uses this.

# ---- Anthropic API (required) ----
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override model. Defaults to claude-opus-4-7.
# CLAUDE_MODEL=claude-sonnet-4-6

# ---- Email delivery (required for briefs) ----
# Resend gives 100 free emails/day — sign up at resend.com.
RESEND_API_KEY=re_...
# Where to send briefs:
RECIPIENT_EMAIL=sashagordin22@gmail.com
# From address. If you don't own a domain yet, use Resend's onboarding sender:
EMAIL_FROM=Briefs <briefs@resend.dev>

# ---- Supabase sync (for the PWA, NOT used by cron) ----
# These get baked into frontend/index.html at deploy time via ./deploy.sh.
# Cron doesn't read them.
SUPABASE_URL=https://yxjxmokypbunbeqjdemo.supabase.co
SUPABASE_ANON_KEY=sb_publishable_B5WD9J7bf0pDNx13vlvqkg_faH8rALx

# ---- Timezone ----
TZ=America/New_York

# ---- Cloudflare Pages deploy (optional, used by deploy.sh) ----
# Token needs Pages:Edit on your account. https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Project name on Cloudflare Pages.
# CLOUDFLARE_PAGES_PROJECT=learning-backlog
